{
  "name": "@eventmatch/back",
  "version": "0.8.1",
  "private": true,
  "scripts": {
    "validate:env": "bun run src/shared/infrastructure/config/validate-env.ts",
    "start": "bun run validate:env && bun dist/main.js",
    "start:dev": "bun run validate:env && bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && bun run build:assets",
    "build:assets": "mkdir -p dist/modules/registration/infrastructure/security/data && cp src/modules/registration/infrastructure/security/data/common-passwords.txt dist/modules/registration/infrastructure/security/data/",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/setup.ts test/unit",
    "test:e2e": "../scripts/test-back-e2e.sh",
    "test:integration": "bun -e \"if (!process.env.DATABASE_INTEGRATION_URL) throw new Error('DATABASE_INTEGRATION_URL is required');\" && bun test --preload ./test/setup.ts test/integration",
    "db:generate": "drizzle-kit generate --config ./src/shared/infrastructure/persistence/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./src/shared/infrastructure/persistence/drizzle.config.ts",
    "db:check": "drizzle-kit check --config ./src/shared/infrastructure/persistence/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./src/shared/infrastructure/persistence/drizzle.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.4",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "drizzle-kit": "0.31.11"
  }
}
