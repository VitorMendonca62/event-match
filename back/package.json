{
  "name": "@eventmatch/back",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "validate:env": "bun run src/shared/infrastructure/config/validate-env.ts",
    "start": "bun run validate:env && bun dist/main.js",
    "start:dev": "bun run validate:env && bun --watch src/main.ts",
    "build": "bun run validate:env && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/setup.ts test/unit",
    "test:e2e": "bun test --preload ./test/setup.ts test/e2e"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.4",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
