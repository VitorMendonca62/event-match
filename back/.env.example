NODE_ENV=development
PORT=3001
HOSTNAME=0.0.0.0
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
DATABASE_URL=postgresql://eventmatch:eventmatch@localhost:5432/eventmatch
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable
# Gere cada chave com: openssl rand -base64 32 (vazias falham na validação de ambiente).
CONTACT_HASH_KEY=
CONTACT_ENCRYPTION_KEY=
VERIFICATION_SECRET_KEY=
REGISTRATION_FLOW_SECRET=
BFF_INTERNAL_TOKEN=
# Rotas /api/v1/registration (SDD-009); mantenha false até o BFF existir.
REGISTRATION_HTTP_ENABLED=false
# brevo | noop (noop não envia nada e é proibido em produção).
VERIFICATION_DELIVERY_MODE=noop
# Obrigatórios com VERIFICATION_DELIVERY_MODE=brevo; nunca versione a chave real.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM=
FRONTEND_PUBLIC_URL=http://localhost:3000
