NODE_ENV=development
PORT=3001
HOSTNAME=0.0.0.0
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
DATABASE_URL=postgresql://eventmatch:eventmatch@localhost:5432/eventmatch
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable
CONTACT_HASH_KEY=replace-with-a-base64-secret-of-at-least-32-bytes
CONTACT_ENCRYPTION_KEY=replace-with-a-base64-secret-of-at-least-32-bytes
VERIFICATION_SECRET_KEY=replace-with-a-base64-secret-of-at-least-32-bytes
