NODE_ENV=development
PORT=3001
HOSTNAME=0.0.0.0
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
DATABASE_URL=postgresql://eventmatch:eventmatch@localhost:5432/eventmatch
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable
# Gere cada chave com: openssl rand -base64 32 (vazias falham na validação de ambiente).
CONTACT_HASH_KEY=
CONTACT_ENCRYPTION_KEY=
VERIFICATION_SECRET_KEY=
REGISTRATION_FLOW_SECRET=
BFF_INTERNAL_TOKEN=
# Rotas /api/v1/registration (SDD-009); mantenha false até o BFF existir.
REGISTRATION_HTTP_ENABLED=false
# brevo | noop (noop não envia nada e é proibido em produção).
VERIFICATION_DELIVERY_MODE=noop
# Obrigatórios com VERIFICATION_DELIVERY_MODE=brevo; nunca versione a chave real.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM=
FRONTEND_PUBLIC_URL=http://localhost:3000
# Autenticação e sessão (SDD-013; ADR-033 a ADR-036). Mantenha false até aplicar a migration 0006
# e publicar o BFF. Com AUTH_HTTP_ENABLED=true (ou em produção) o segredo é obrigatório:
# openssl rand -base64 32, diferente de REGISTRATION_FLOW_SECRET.
AUTH_HTTP_ENABLED=false
AUTH_SESSION_SECRET=
# Padrões confirmados; produção recusa valores abaixo dos mínimos documentados.
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_REMEMBERED_ABSOLUTE_TTL_SECONDS=2592000
AUTH_REMEMBERED_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
AUTH_SESSION_RENEWAL_INTERVAL_SECONDS=86400
AUTH_SESSION_PREVIOUS_TOKEN_GRACE_SECONDS=60
AUTH_MAX_SESSIONS_PER_ACCOUNT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_CONTACT_LIMIT=5
AUTH_LOGIN_ORIGIN_LIMIT=30

# Perfil autenticado (SDD-015; ADR-038 a ADR-040). Aplique a migration 0007 antes de habilitar.
PROFILE_HTTP_ENABLED=false
PROFILE_MEDIA_ENABLED=false
PROFILE_MEDIA_PROVIDER=cloudinary
PROFILE_MEDIA_SMOKE_ENABLED=false
# Caminho local para JPEG >=320x320 contendo EXIF/GPS; usado somente pelo smoke opt-in.
PROFILE_MEDIA_SMOKE_FIXTURE=
# Chaves independentes, base64 com 32+ bytes: openssl rand -base64 32
PROFILE_INVITATION_KEY=
PROFILE_MEDIA_KEY=
PROFILE_PHOTO_UPLOAD_TTL_SECONDS=300
PROFILE_PHOTO_MAX_BYTES=5242880
PROFILE_PHOTO_ACCOUNT_DAILY_LIMIT=10
PROFILE_PHOTO_ORIGIN_15M_LIMIT=30
# Obrigatórios somente com PROFILE_MEDIA_ENABLED=true. Nunca versione valores reais.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_UPLOAD_PRESET=
