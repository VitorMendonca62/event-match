{
  "name": "@eventmatch/front",
  "version": "0.19.1",
  "private": true,
  "scripts": {
    "validate:env": "bun run src/shared/config/validate-env.ts",
    "dev": "bun run validate:env && next dev",
    "build": "next build --webpack",
    "start": "bun run validate:env && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ../front/tests/preload/server-only.ts",
    "test:server-boundary": "bash tests/verify-server-only-boundary.sh",
    "test:e2e": "../scripts/test-front-e2e.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "pg": "8.16.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
