NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Registration BFF (server-only; never prefix with NEXT_PUBLIC_).
BACKEND_INTERNAL_URL=http://localhost:3001
FRONTEND_PUBLIC_URL=http://localhost:3000
# Same value as back/.env BFF_INTERNAL_TOKEN. Generate: openssl rand -base64 32
BFF_INTERNAL_TOKEN=
# Generate: openssl rand -base64 32
ORIGIN_FINGERPRINT_KEY=
# `vercel` in production; `fixture` only for local development and tests.
EDGE_PROVIDER=fixture
BACKEND_TIMEOUT_MS=8000

# Login e primeira área autenticada (SDD-013; ADR-034/037). Server-only. Ligue somente depois
# de AUTH_HTTP_ENABLED=true no backend; desligar oculta /entrar, /inicio e /api/auth/**.
AUTH_UI_ENABLED=false

# Convite, edição e prévia do perfil (SDD-015). Ligue somente depois de PROFILE_HTTP_ENABLED
# e, para foto, PROFILE_MEDIA_ENABLED no backend.
PROFILE_UI_ENABLED=false
